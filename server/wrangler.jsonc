{
  // One Worker serves the web app (static assets), REST API, MCP and AI agent.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gallivanter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f0a40f67e87b4b3ca50d0680cc4f1ab8",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gallivanter",
      // Replaced with the real id after `wrangler d1 create gallivanter`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // TOKEN_KEY (base64 32 bytes), DEEPSEEK_API_KEY
}
