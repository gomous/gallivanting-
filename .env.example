# Optional browser configuration. Leave blank for local-first operation.
VITE_GOOGLE_CLIENT_ID=

# Manual Cloudflare deployment credentials. Never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Only used by the legacy standalone Worker fallback.
CF_SUBDOMAIN=

# Optional local Electron/browser tooling settings.
ELECTRON_RENDERER_URL=http://127.0.0.1:5173
CDP_ENDPOINT=http://127.0.0.1:9222
