{
  "name": "gallivanting",
  "version": "0.1.0",
  "description": "A focused desktop CRM workspace.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.12.x",
    "npm": ">=10 <11"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "web:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "web:build": "vite build --outDir web-dist --emptyOutDir",
    "electron:dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --experimental-strip-types --test src/crm/engine.test.ts src/backend/localBackend.test.ts src/moduleRecords.test.ts electron/persistence.test.ts",
    "verify": "npm run typecheck && npm run server:typecheck && npm run web:build",
    "typecheck": "tsc --noEmit",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:smoke": "node server/smoke.mjs",
    "deploy": "npm run web:build && wrangler deploy -c server/wrangler.jsonc"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "form-data": "^4.0.6",
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "26.6.4",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "wrangler": "^4.151.0"
  }
}
